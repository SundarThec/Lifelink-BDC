# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Leave empty to use automatic embedded MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/lifelink_pro

# Security & JWT
JWT_SECRET=lifelink_super_secure_jwt_production_secret_key_2026_blood_community
JWT_EXPIRES_IN=7d

# Real Email Notification Service (SMTP)
# Configure an authentic SMTP account to dispatch real emergency blood alerts to nearby donors.
#
# Option A: Real Gmail Delivery
#   SMTP_SERVICE=gmail
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_16_char_google_app_password
#   EMAIL_FROM="LifeLink Emergency Alerts" <your_email@gmail.com>
#
# Option B: Transactional SMTP (SendGrid, Mailgun, Brevo, AWS SES, Outlook)
#   SMTP_HOST=smtp.mailgun.org (or smtp-relay.brevo.com / smtp.office365.com)
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your_smtp_username
#   SMTP_PASS=your_smtp_password
#   EMAIL_FROM="LifeLink Emergency Alerts" <alerts@yourdomain.com>
#
# Option C: Offline Preview Mode (Isolated developer test only)
#   Set ALLOW_ETHEREAL_TEST=true to generate ephemeral preview URLs when real SMTP is unconfigured.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LifeLink Emergency Alerts" <alerts@lifelink.org>
ALLOW_ETHEREAL_TEST=false

# Offline Map & Tile Configuration
TILE_DIR=public/tiles

# Offline Geocoding Gazetteer Path
GEOJSON_GAZETTEER_PATH=data/gazetteer.geojson

# Automatic Radius Escalation Tiers (radiusKm:hoursElapsed)
# Format: radiusKm:hoursElapsed,radiusKm:hoursElapsed,...
# 0 hours = on creation (5 km), 1 hour = 10 km, 2 hours = 50 km
ESCALATION_TIERS=5:0,10:1,50:2
